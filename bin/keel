#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
# readlink -f handles the installed symlink and relative/chained symlinks.
KEEL_EXECUTABLE="$(readlink -f -- "${BASH_SOURCE[0]}")"
KEEL_HOME="$(cd -- "$(dirname -- "$KEEL_EXECUTABLE")/.." && pwd -P)"
# shellcheck source=lib/common.sh
source "$KEEL_HOME/lib/common.sh"
# shellcheck source=lib/keys.sh
source "$KEEL_HOME/lib/keys.sh"
# shellcheck source=lib/prepare.sh
source "$KEEL_HOME/lib/prepare.sh"
# shellcheck source=lib/session.sh
source "$KEEL_HOME/lib/session.sh"
# shellcheck source=lib/ssh.sh
source "$KEEL_HOME/lib/ssh.sh"
# shellcheck source=lib/transaction.sh
source "$KEEL_HOME/lib/transaction.sh"
# shellcheck source=lib/security.sh
source "$KEEL_HOME/lib/security.sh"
# shellcheck source=lib/doctor.sh
source "$KEEL_HOME/lib/doctor.sh"
usage() {
  cat <<'USAGE'

  Keel / Experimental v0.1

  Usage
    keel <command>

  Setup
    init              Interactive preparation; preserve existing access (sudo)
    tailscale-ssh     Enable Tailscale SSH before verification (sudo)
    tailscale-policy  Print a policy template (sudo)
                        [--tag tag:NAME] [--port PORT]

  Secure access
    verify            Prove selected SSH authentication and sudo
    secure            Review/apply hardening with timed recovery
    confirm           Confirm a fresh post-change connection

  Inspect and recover
    doctor            Read-only configuration and Docker report (sudo)
    status            Read-only transaction status (sudo)
    rollback          Restore a pending transaction (sudo)
    help              Show this help

  Run verify/secure/confirm WITHOUT sudo from the administrator SSH login.
  From a reviewed checkout: sudo bash ./bin/keel init
USAGE
}
command="${1:-help}"
case "$command" in
  help|-h|--help) usage ;;
  init)
    keel_require_root
    keel_require_ubuntu
    keel_lock
    keel_no_pending
    if [[ "$KEEL_HOME" != /opt/keel ]]; then
      keel_install_self "$KEEL_HOME"
      exec {KEEL_LOCK_FD}>&-
      exec /opt/keel/bin/keel init
    fi
    keel_init ;;
  verify|secure|confirm)
    (( EUID != 0 )) || keel_die "Run keel $command without sudo from the administrator SSH login."
    sudo -v
    exec sudo -- /usr/local/bin/keel "__$command" ;;
  __verify|__secure|__confirm)
    keel_require_root
    keel_require_ubuntu
    keel_lock
    case "$command" in
      __verify) keel_verify ;;
      __secure) keel_secure ;;
      __confirm) keel_confirm ;;
    esac ;;
  tailscale-ssh)
    keel_require_root
    keel_lock
    keel_enable_tailscale_ssh ;;
  tailscale-policy)
    keel_require_root
    keel_load_config
    shift
    keel_tailscale_policy "$@" ;;
  doctor)
    keel_require_root
    keel_doctor ;;
  status)
    keel_require_root
    keel_ui_section 'Keel / Recovery'
    keel_status ;;
  rollback|__rollback|__recover-boot)
    keel_require_root
    keel_lock
    keel_rollback "${2:-}" ;;
  *) usage; exit 2 ;;
esac
