#!/usr/bin/env bash
set -Eeuo pipefail

KEEL_HOME="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=lib/common.sh
source "$KEEL_HOME/lib/common.sh"
# shellcheck source=lib/prepare.sh
source "$KEEL_HOME/lib/prepare.sh"
# shellcheck source=lib/security.sh
source "$KEEL_HOME/lib/security.sh"
# shellcheck source=lib/doctor.sh
source "$KEEL_HOME/lib/doctor.sh"

usage() {
  cat <<'USAGE'
Keel — bootstrap and secure Ubuntu servers (experimental v0.1)

Usage:
  keel init          Interactive preparation, no firewall lockdown
  keel verify        Prove a new SSH login and sudo access
  keel secure        Apply hardening with timed automatic rollback
  keel confirm       Confirm a fresh connection and cancel rollback
  keel doctor        Read-only configuration report
  keel tailscale-ssh Enable Tailscale SSH (after configuring your tailnet policy)
  keel help

Run init from a checkout with: sudo bash ./bin/keel init
After init, use the installed command: keel <subcommand>
USAGE
}

command="${1:-help}"
case "$command" in
  help|-h|--help) usage ;;
  init)
    keel_require_root
    if [[ "$KEEL_HOME" != "/opt/keel" ]]; then
      keel_install_self "$KEEL_HOME"
      exec /usr/local/bin/keel init
    fi
    keel_init
    ;;
  verify|confirm)
    # Collect the unprivileged SSH session BEFORE sudo sanitizes the environment.
    if [[ "$EUID" -ne 0 ]]; then
      [[ -n "${SSH_CONNECTION:-}" ]] ||
        keel_die "Run from a new SSH connection, not a local shell."
      sudo -v
      exec sudo env KEEL_SESSION="$SSH_CONNECTION" \
        /usr/local/bin/keel "__$command"
    fi
    keel_die "Run 'keel $command' without sudo from your new SSH session."
    ;;
  secure)
    if [[ "$EUID" -ne 0 ]]; then
      [[ -n "${SSH_CONNECTION:-}" ]] ||
        keel_die "Run from an SSH session; keep another SSH session open."
      exec sudo env KEEL_SESSION="$SSH_CONNECTION" \
        /usr/local/bin/keel __secure
    fi
    keel_die "Run 'keel secure' without sudo from the new admin account."
    ;;
  tailscale-ssh)
    keel_require_root
    keel_enable_tailscale_ssh
    ;;
  doctor)
    keel_require_root
    keel_doctor
    ;;
  __verify)
    keel_require_root
    keel_verify
    ;;
  __secure)
    keel_require_root
    keel_secure
    ;;
  __confirm)
    keel_require_root
    keel_confirm
    ;;
  __rollback)
    keel_require_root
    keel_rollback
    ;;
  *) usage; exit 2 ;;
esac
